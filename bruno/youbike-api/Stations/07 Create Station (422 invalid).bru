meta {
  name: 07 Create Station (422 invalid)
  type: http
  seq: 7
}

post {
  url: {{api}}/stations
  body: json
  auth: none
}

body:json {
  {
    "sno": "BRUNO0002",
    "name_zh": "YouBike2.0_Bruno測試站",
    "name_en": "Bruno Test Sta.",
    "area_id": {{areaId}},
    "address_zh": "測試路1號",
    "address_en": "No.1, Test Rd.",
    "latitude": 999,
    "longitude": 121.5654,
    "total_docks": 20,
    "available_bikes": 8,
    "available_docks": 12,
    "is_active": true
  }
}

assert {
  res.status: eq 422
}

docs {
  latitude 超出 -90~90 範圍，Pydantic 驗證失敗回 422。
}
