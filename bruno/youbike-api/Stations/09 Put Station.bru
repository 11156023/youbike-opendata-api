meta {
  name: 09 Put Station
  type: http
  seq: 9
}

put {
  url: {{api}}/stations/BRUNO0001
  body: json
  auth: none
}

body:json {
  {
    "name_zh": "YouBike2.0_Bruno測試站",
    "name_en": "Bruno Test Sta.",
    "area_id": {{areaId}},
    "address_zh": "測試路1號",
    "address_en": "No.1, Test Rd.",
    "latitude": 25.033,
    "longitude": 121.5654,
    "total_docks": 30,
    "available_bikes": 8,
    "available_docks": 22,
    "is_active": true
  }
}

assert {
  res.status: eq 200
  res.body.total_docks: eq 30
}
